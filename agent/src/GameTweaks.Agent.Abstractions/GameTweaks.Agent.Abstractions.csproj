<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Version>0.1.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <IsPackable>true</IsPackable>
    <PackageId>GameTweaks.Agent.Abstractions</PackageId>
    <NuspecFile>GameTweaks.Agent.Abstractions.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildProjectDirectory)</NuspecBasePath>
    <NuspecProperties>version=$(Version);configuration=$(Configuration)</NuspecProperties>
    <!-- NU5131 cannot model a PackageReference-only package that intentionally
         contains a ref assembly without a legacy lib assembly. The packaging
         smoke test verifies the resulting compile/runtime asset contract. -->
    <NoWarn>$(NoWarn);NU5131</NoWarn>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
