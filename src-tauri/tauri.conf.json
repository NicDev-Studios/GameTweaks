{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameTweaks",
  "version": "0.0.0-dev",
  "identifier": "dev.gametweaks.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:frontend",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "GameTweaks",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "Game tweaks desktop app",
    "longDescription": "GameTweaks is a desktop app for managing game tweaks."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDQkNDOTE3MjlBMjA3OTYKUldTV0I2SXBGOG04ZkZjMDh6dWx5TE1NNDJnVUpkWHJNUUtKR2wxb3l6dVdCQS9Namkza09kNjUK",
      "endpoints": [
        "https://github.com/NicDev-Studios/GameTweaks/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
